{
  "name": "boat-simulator",
  "version": "24.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/inline-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "audit:physics": "node scripts/audit-v17.mjs",
    "test:e2e": "playwright test",
    "test:production": "npm run build && playwright test --config playwright.production.config.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "vite": "^7.1.12"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
